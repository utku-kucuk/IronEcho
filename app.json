{
  "expo": {
    "name": "ironEcho",
    "slug": "ironEcho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gym-images/benchpress/benchpress01.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ironEcho",
      "deploymentTarget": "18.3",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/gym-images/benchpress/benchpress01.jpeg",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2884eb82-9a50-4bb0-9f5a-f07e63b810c2"
      }
    }
  }
}