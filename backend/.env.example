# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ironecho
MONGODB_USERNAME=
MONGODB_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-replace-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:19006,exp://your-local-ip:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSL Configuration (for production)
SSL_CERT_PATH=
SSL_KEY_PATH=
